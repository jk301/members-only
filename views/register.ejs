<!DOCTYPE html>
<html>
    <head></head>
    <body>
        <h1>This is register</h1>

        <div class="alerts-container">
            <% if (typeof alerts !== 'undefined' && alerts) { %>
                <ul>
                    <% alerts.forEach ( alert  => { %>
                        <li> <%= alert %> </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>

        <form action="/register" method="POST">
            <label for="username">
                Username : 
                <input 
                    type="text" 
                    value="<%= typeof username !== 'undefined' ? username : '' %>" 
                    name="username" 
                    id="username" 
                    placeholder="Username here" 
                    required>
            </label>
            <label for="password">
                Password : 
                <input 
                    type="text" 
                    name="password" 
                    placeholder="password here" 
                    id="password" 
                    required>
            </label>
            <label for="cnfrm-pass">
                Confirm Password : 
                <input 
                    type="text" 
                    name="cnfrm_pass" 
                    placeholder="confirm password" 
                    id="cnfrm-pass" 
                    required>
            </label>
            <button type="submit">Submit</button>
        </form>
    </body>
</html>