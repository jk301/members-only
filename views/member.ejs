<!DOCTYPE html>
<html>
    <head></head>
    <body>
        <h1>This is member check</h1>

        <div class="alerts-container">
            <% if (typeof alerts !== 'undefined' && alerts) { %>
                <ul>
                    <% alerts.forEach ( alert  => { %>
                        <li> <%= alert %> </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>

        <form action="/member" method="POST">
            <label for="mem-pass">
                Whats the password ?  
                <input type="password" name="memPass" id="mem-pass" required>
            </label>
            <button type="submit">Submit</button>
        </form>
        <a href="/">
            <button>Go Home</button>
        </a>
    </body>
</html>