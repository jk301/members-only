<!DOCTYPE html>
<html>
    <head></head>
    <nav>
        <h1>Only-members hehe.</h1>
        <% if (logged) { %>
            <div class="nav-user-details">
                <p>Welcome <%= user.username %></p>
                <p>A Member ? <%= user.member ? 'yes' : 'no' %></p>
                <p>An Admin ? <%= user.admin ? 'yes' : 'no' %></p>
            </div>
            <div class="nav-user-buttons">
                <a href="/member">
                    <button>Member</button>
                </a>
                <a href="/message">
                    <button>Message</button>
                </a>
                <a href="/admin">
                    <button>Admin</button>
                </a>
                <form action="/logout" method="POST">
                    <button type="submit">Logout</button>
                </form>
            </div>

        <% } else { %>

            <div class="new-nav">
                <a href="/register">
                    <button>Register</button>
                </a>
                <a href="/login">
                    <button>Login</button>
                </a>
            </div>

        <% } %>
        </nav>
    
</html>