<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="navbar.css">
    </head>
    <nav>
        <h1>Only-members</h1>
        <% if (logged) { %>
            <div class="nav-user-details">
                <h2>Welcome <%= user.username %></h2>
                <p><%= user.member ? 'Member ✔' : '' %></p>
                <p><%= user.admin ? 'Admin ✔' : '' %></p>
            </div>
            <div class="nav-user-buttons">
                <% if (!user.member) { %>
                    <a href="/member">
                        <button>Become a member</button>
                    </a>
                <% } %>
                
                <a href="/message">
                    <button>Create a message</button>
                </a>
                <% if (!user.admin) { %>
                    <a href="/admin">
                        <button>Admin ?</button>
                    </a>
                <% } %>
                <form action="/logout" method="POST">
                    <button type="submit">Logout</button>
                </form>
            </div>

        <% } else { %>

            <div class="nav-user-buttons">
                <a href="/register">
                    <button>Register</button>
                </a>
                <a href="/login">
                    <button>Login</button>
                </a>
            </div>

        <% } %>
        </nav>
    
</html>