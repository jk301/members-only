<!DOCTYPE html>
<html>
    <head></head>
    <body>
        <h1>This is admin check</h1>
        <% if (typeof message !== 'undefined' && message) { %>
            <p><%= message %></p>
        <% } %> 
        <form action="/admin" method="POST">
            <label for="admin-pass">
                (passed the jwt auth)
                <input type="password" name="adminPass" id="admin-pass" required>
            </label>
            <button type="submit">Submit</button>
        </form>
        <a href="/">
            <button>Go Home</button>
        </a>
    </body>
</html>