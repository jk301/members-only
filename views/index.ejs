<!DOCTYPE html>
<html>
    <head></head>
    <body>
        <%- include('./partials/navbar') %>
        <% if (logged) { %>
            <% if (typeof admin !== 'undefined' && admin) { %>
                <div class="msg-div-container">
                    <% if (typeof messages !== 'undefined' && messages) { %>
                        <% messages.forEach ((msg) => { %>
                            <div class="msg-card">
                                <h3><%= msg.title  %></h3>
                                <p><%= msg.message  %></p>
                                <div>
                                    <p><%= msg.time %></p>
                                    <h4><%= msg.username %></h4>
                                </div>
                                <form action="/messages/delete/<%= msg.messageid %>" method="POST">
                                    <button type="submit">Delete message</button>
                                </form>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            <% } else if (typeof member !== 'undefined' && member) { %>
                <div class="msg-div-container">
                    <% if (typeof messages !== 'undefined' && messages) { %>
                        <% messages.forEach ((msg) => { %>
                            <div class="msg-card">
                                <h3><%= msg.title  %></h3>
                                <p><%= msg.message  %></p>
                                <div>
                                    <p><%= msg.time %></p>
                                    <h4><%= msg.username %></h4>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            <% } else { %>
                
                <div class="msg-div-container">
                    <% if (typeof messages !== 'undefined' && messages) { %>
                        <% messages.forEach ((msg) => { %>
                            <div class="msg-card">
                                <h3><%= msg.title  %></h3>
                                <p><%= msg.message  %></p>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            <% } %>

        <% } else { %>

            <div class="msg-div-container">
                <% if (typeof messages !== 'undefined' && messages) { %>
                    <% messages.forEach ((msg) => { %>
                        <div class="msg-card">
                            <h3><%= msg.title  %></h3>
                            <p><%= msg.message  %></p>
                        </div>
                    <% }) %>
                <% } %>
            </div>

        <% } %>
    </body>
    
</html>